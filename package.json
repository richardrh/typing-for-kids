{
  "name": "typing-for-kids",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:landing": "lighthouse http://127.0.0.1:4173/ --chrome-flags=\"--headless --no-sandbox\" --only-categories=performance,accessibility,best-practices,seo --output=html --output=json --output-path=./lighthouse-report --quiet",
    "audit:landing:desktop": "lighthouse http://127.0.0.1:4173/ --chrome-flags=\"--headless --no-sandbox\" --preset=desktop --only-categories=performance,accessibility,best-practices,seo --output=html --output=json --output-path=./lighthouse-report-desktop --quiet"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.12"
  }
}
